{
  "name": "chatgpt-desktop-linux",
  "version": "0.7.8",
  "description": "Unofficial ChatGPT desktop app for Linux, with tabs, global shortcuts and KDE Plasma integration",
  "homepage": "https://github.com/Calciiferr/chatgpt-desktop-linux",
  "repository": {
    "type": "git",
    "url": "https://github.com/Calciiferr/chatgpt-desktop-linux.git"
  },
  "author": {
    "name": "Calciiferr",
    "url": "https://github.com/Calciiferr"
  },
  "license": "MIT",
  "main": "dist/main.js",
  "desktopName": "chatgpt-desktop-linux.desktop",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "test": "npm run build && node --test --test-concurrency=1 \"test/*.test.cjs\"",
    "dist": "npm run build && electron-builder --linux AppImage deb",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:appimage": "npm run build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "42.5.0",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "io.github.calciiferr.ChatGPTDesktopLinux",
    "productName": "ChatGPT Desktop Linux",
    "executableName": "chatgpt-desktop-linux",
    "asar": true,
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "assets/icon.png",
      "assets/tray-icon.png",
      "assets/tray-icon-light.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/chatgpt-desktop-linux-servicemenu.desktop",
        "to": "chatgpt-desktop-linux-servicemenu.desktop"
      },
      {
        "from": "vendor/nestfolders",
        "to": "nestfolders",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "appImage": {
      "artifactName": "ChatGPT-Desktop-Linux-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "ChatGPT-Desktop-Linux-${version}-${arch}.${ext}",
      "packageName": "chatgpt-desktop-linux",
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libnspr4",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libc6",
        "libgcc-s1",
        "libglib2.0-0t64 | libglib2.0-0",
        "libatk1.0-0t64 | libatk1.0-0",
        "libatk-bridge2.0-0t64 | libatk-bridge2.0-0",
        "libcups2t64 | libcups2",
        "libdbus-1-3",
        "libcairo2",
        "libpango-1.0-0",
        "libx11-6",
        "libxcomposite1",
        "libxdamage1",
        "libxext6",
        "libxfixes3",
        "libxrandr2",
        "libgbm1",
        "libexpat1",
        "libxcb1",
        "libxkbcommon0",
        "libudev1",
        "libayatana-appindicator3-1 | libappindicator3-1",
        "kde-spectacle",
        "libglib2.0-bin",
        "qdbus-qt6",
        "libkf6config-bin",
        "libkf6service-bin",
        "kglobalacceld (>= 6.0)",
        "kwin-wayland (>= 4:6.0)",
        "plasma-workspace (>= 4:6.0)",
        "xdg-desktop-portal",
        "xdg-desktop-portal-kde (>= 6.0)",
        "dolphin",
        "kate",
        "pkexec"
      ],
      "recommends": []
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "Calciiferr <158118428+Calciiferr@users.noreply.github.com>",
      "syncDesktopName": true,
      "executableArgs": [
        "--toggle"
      ],
      "desktop": {
        "entry": {
          "Name": "ChatGPT",
          "GenericName": "Assistant IA",
          "Comment": "Utiliser ChatGPT dans une fenêtre dédiée",
          "Keywords": "ChatGPT;OpenAI;IA;AI;Assistant;",
          "Actions": "Toggle;Companion;Clipboard;Settings;",
          "Terminal": "false",
          "StartupNotify": "true"
        },
        "desktopActions": {
          "Toggle": {
            "Name": "Afficher/masquer ChatGPT",
            "Exec": "chatgpt-desktop-linux --toggle",
            "X-KDE-Shortcuts": "Ctrl+Alt+G"
          },
          "Companion": {
            "Name": "Ouvrir la Magic Bar",
            "Exec": "chatgpt-desktop-linux --companion",
            "X-KDE-Shortcuts": "Ctrl+Shift+Space"
          },
          "Clipboard": {
            "Name": "Ouvrir avec le presse-papiers",
            "Exec": "chatgpt-desktop-linux --clipboard"
          },
          "Settings": {
            "Name": "Paramètres",
            "Exec": "chatgpt-desktop-linux --settings"
          }
        }
      },
      "synopsis": "Unofficial ChatGPT desktop app for Linux",
      "description": "Use chatgpt.com in a dedicated window with tabs, a tray icon and global shortcuts. Unofficial, not affiliated with OpenAI."
    }
  }
}
