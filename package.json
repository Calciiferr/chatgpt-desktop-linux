{
  "name": "chatgpt-desktop-linux",
  "version": "0.7.0-beta.32",
  "private": true,
  "description": "Personal ChatGPT desktop wrapper for Linux, KDE Plasma and Wayland",
  "homepage": "https://chatgpt.com/",
  "main": "dist/main.js",
  "desktopName": "chatgpt-desktop-linux.desktop",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "test:projects": "npm run build && node scripts/test-projects.cjs",
    "test:companion": "npm run build && node scripts/test-companion-draft.cjs",
    "test:tabs": "npm run build && node scripts/test-tabs.cjs",
    "test:clipboard": "npm run build && node scripts/test-clipboard-files.cjs",
    "test:attachments": "npm run build && node scripts/test-attachment-transfer.cjs",
    "test:project-sync": "npm run build && node scripts/test-project-sync-policy.cjs",
    "test:diagnostics": "npm run build && node scripts/test-settings-diagnostics.cjs",
    "test:throttling": "npm run build && node scripts/test-chat-tab-throttling.cjs",
    "test:kde-shortcuts": "node scripts/test-kde-shortcuts.cjs",
    "test:preview": "npm run build && node scripts/test-companion-preview.cjs",
    "test": "npm run build && node scripts/test-projects.cjs && node scripts/test-companion-draft.cjs && node scripts/test-tabs.cjs && node scripts/test-clipboard-files.cjs && node scripts/test-attachment-transfer.cjs && node scripts/test-project-sync-policy.cjs && node scripts/test-settings-diagnostics.cjs && node scripts/test-chat-tab-throttling.cjs && node scripts/test-kde-shortcuts.cjs && node scripts/test-companion-preview.cjs && node scripts/test-auth-navigation.cjs && node scripts/test-github-updater.cjs && node scripts/test-github-device-auth.cjs && node scripts/test-conversation-colors.cjs && node scripts/test-debian-update.cjs && node scripts/test-release-notes.cjs",
    "handoff:zip": "./scripts/make-ai-handoff-zip.sh",
    "handoff:zip:debug": "./scripts/make-ai-handoff-zip.sh --include-debug",
    "predist": "node scripts/archive-release.cjs deb appimage",
    "dist": "npm run build && electron-builder --linux AppImage deb",
    "predist:appimage": "node scripts/archive-release.cjs appimage",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "predist:deb": "node scripts/archive-release.cjs deb",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "test:auth": "npm run build && node scripts/test-auth-navigation.cjs",
    "test:updates": "npm run build && node scripts/test-github-updater.cjs && node scripts/test-github-device-auth.cjs && node scripts/test-debian-update.cjs",
    "test:colors": "npm run build && node scripts/test-conversation-colors.cjs",
    "test:release-notes": "node scripts/test-release-notes.cjs"
  },
  "author": {
    "name": "Calciiferr",
    "email": "158118428+Calciiferr@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "42.5.0",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "io.github.calciiferr.ChatGPTDesktopLinux",
    "productName": "ChatGPT Desktop Linux",
    "executableName": "chatgpt-desktop-linux",
    "asar": true,
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "assets/icon.png",
      "assets/tray-icon.png",
      "assets/tray-icon-light.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/chatgpt-desktop-linux-servicemenu.desktop",
        "to": "chatgpt-desktop-linux-servicemenu.desktop"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "appImage": {
      "artifactName": "ChatGPT-Desktop-Linux-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "ChatGPT-Desktop-Linux-${version}-${arch}.${ext}",
      "packageName": "chatgpt-desktop-linux",
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libnspr4",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libc6",
        "libgcc-s1",
        "libglib2.0-0t64 | libglib2.0-0",
        "libatk1.0-0t64 | libatk1.0-0",
        "libatk-bridge2.0-0t64 | libatk-bridge2.0-0",
        "libcups2t64 | libcups2",
        "libdbus-1-3",
        "libcairo2",
        "libpango-1.0-0",
        "libx11-6",
        "libxcomposite1",
        "libxdamage1",
        "libxext6",
        "libxfixes3",
        "libxrandr2",
        "libgbm1",
        "libexpat1",
        "libxcb1",
        "libxkbcommon0",
        "libudev1",
        "libayatana-appindicator3-1 | libappindicator3-1",
        "kde-spectacle",
        "libglib2.0-bin",
        "qdbus-qt6",
        "libkf6config-bin",
        "libkf6service-bin",
        "kglobalacceld (>= 6.0)",
        "kwin-wayland (>= 4:6.0)",
        "plasma-workspace (>= 4:6.0)",
        "xdg-desktop-portal",
        "xdg-desktop-portal-kde (>= 6.0)",
        "dolphin",
        "kate",
        "pkexec"
      ],
      "recommends": []
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "Calciiferr <158118428+Calciiferr@users.noreply.github.com>",
      "syncDesktopName": true,
      "executableArgs": [
        "--toggle"
      ],
      "desktop": {
        "entry": {
          "Name": "ChatGPT",
          "GenericName": "Assistant IA",
          "Comment": "Utiliser ChatGPT dans une fenêtre dédiée",
          "Keywords": "ChatGPT;OpenAI;IA;AI;Assistant;",
          "Actions": "Toggle;Companion;Clipboard;Settings;",
          "Terminal": "false",
          "StartupNotify": "true"
        },
        "desktopActions": {
          "Toggle": {
            "Name": "Afficher/masquer ChatGPT",
            "Exec": "chatgpt-desktop-linux --toggle",
            "X-KDE-Shortcuts": "Ctrl+Alt+G"
          },
          "Companion": {
            "Name": "Ouvrir la Magic Bar",
            "Exec": "chatgpt-desktop-linux --companion",
            "X-KDE-Shortcuts": "Ctrl+Shift+Space"
          },
          "Clipboard": {
            "Name": "Ouvrir avec le presse-papiers",
            "Exec": "chatgpt-desktop-linux --clipboard"
          },
          "Settings": {
            "Name": "Paramètres",
            "Exec": "chatgpt-desktop-linux --settings"
          }
        }
      },
      "synopsis": "ChatGPT dans une fenêtre Linux dédiée",
      "description": "Application personnelle pour utiliser chatgpt.com sous KDE, avec une icône de notification et un raccourci global."
    }
  }
}
