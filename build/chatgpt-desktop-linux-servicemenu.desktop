[Desktop Entry]
Type=Service
Name=Envoyer à ChatGPT
MimeType=all/allfiles;
Actions=AskChatGPT;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin

[Desktop Action AskChatGPT]
Name=Envoyer à ChatGPT
Name[en]=Send to ChatGPT
Name[es]=Enviar a ChatGPT
Icon=chatgpt-desktop-linux
Exec=chatgpt-desktop-linux --source Dolphin --attach %F
